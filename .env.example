# PostgreSQLa (one database for the whole app)
DB_URL=jdbc:postgresql://localhost:5433/interview
# Hosted Postgres (e.g. Neon): put everything in DB_URL and drop DB_USERNAME / DB_PASSWORD:
#   DB_URL=jdbc:postgresql://<host>/<db>?user=<user>&password=<password>&sslmode=require
DB_USERNAME=interviewuser
DB_PASSWORD=your-database-password

JWT_SECRET=your-jwt-secret-key-min-32-chars
GOOGLE_CLIENT_ID=your-google-client-id
CORS_ALLOWED_ORIGINS=http://localhost:3000
